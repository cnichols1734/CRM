{
  "pack_key": "lease_tenant",
  "version": "v1",
  "name": "Lease Listing + Tenant Packet",
  "description": "Landlord listing (L1–L9) and tenant application packet (T1–T6). Sensitive evidence requires secure portal upload — never Telegram.",
  "sides": ["landlord", "tenant"],
  "privacy": {
    "requires_privacy_controls": true,
    "telegram_forbidden_evidence": ["paystub", "government_id", "lease_application", "bank_statement"]
  },
  "phases": [
    {
      "phase_key": "listing_prep",
      "name": "Listing Prep",
      "description": "Landlord listing documentation and marketing setup"
    },
    {
      "phase_key": "listing_ops",
      "name": "Listing Ops",
      "description": "Photos, lockbox, MLS, and compliance uploads"
    },
    {
      "phase_key": "lease_prep",
      "name": "Lease Prep",
      "description": "Prepare and close the lease"
    },
    {
      "phase_key": "tenant_packet",
      "name": "Tenant Packet",
      "description": "Collect and transfer applicant documentation securely"
    }
  ],
  "requirements": {
    "prepare_listing_docs": {
      "phase": "listing_prep",
      "title": "Prepare listing documentation",
      "description": "Assemble landlord listing paperwork package",
      "deadline_rule": {
        "anchor": "listing_start_date",
        "offset_days": 0,
        "unit": "calendar",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["landlord"],
      "evidence_types": ["document", "attestation"]
    },
    "send_landlord_paperwork_copies": {
      "phase": "listing_prep",
      "title": "Send landlord listing paperwork copies",
      "description": "Deliver paperwork copies via portal or email (not Telegram for sensitive)",
      "deadline_rule": {
        "anchor": "listing_start_date",
        "offset_days": 1,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["landlord"],
      "evidence_types": ["email", "portal", "attestation"],
      "telegram_forbidden": false
    },
    "schedule_photos": {
      "phase": "listing_ops",
      "title": "Schedule photos",
      "description": "Schedule property photography",
      "deadline_rule": {
        "anchor": "listing_start_date",
        "offset_days": 3,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": false,
      "sides": ["landlord"],
      "evidence_types": ["attestation", "task"]
    },
    "schedule_lockbox_sign": {
      "phase": "listing_ops",
      "title": "Schedule lockbox and sign",
      "description": "Arrange lockbox install and yard sign",
      "deadline_rule": {
        "anchor": "listing_start_date",
        "offset_days": 3,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": false,
      "sides": ["landlord"],
      "evidence_types": ["attestation", "task"]
    },
    "mls_listing_data": {
      "phase": "listing_ops",
      "title": "Input listing data into MLS",
      "description": "Enter listing in MLS (attestation — no write integration)",
      "deadline_rule": {
        "anchor": "listing_start_date",
        "offset_days": 5,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["landlord"],
      "evidence_types": ["attestation"]
    },
    "mls_upload_docs_photos": {
      "phase": "listing_ops",
      "title": "Upload docs/photos into MLS",
      "description": "Upload listing media to MLS (attestation)",
      "deadline_rule": {
        "anchor": "listing_start_date",
        "offset_days": 5,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": false,
      "sides": ["landlord"],
      "evidence_types": ["attestation"]
    },
    "compliance_upload_listing": {
      "phase": "listing_ops",
      "title": "Upload docs into compliance",
      "description": "Upload listing package to brokerage compliance (attestation)",
      "deadline_rule": {
        "anchor": "listing_start_date",
        "offset_days": 7,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["landlord"],
      "evidence_types": ["attestation", "document"]
    },
    "prepare_lease": {
      "phase": "lease_prep",
      "title": "Prepare the lease",
      "description": "Prepare lease for landlord signature (human/upload; generation frozen)",
      "deadline_rule": {
        "anchor": "lease_start_date",
        "offset_days": -7,
        "unit": "calendar",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["landlord"],
      "evidence_types": ["document", "attestation"],
      "sensitivity_class": "confidential"
    },
    "close_mls_listing": {
      "phase": "lease_prep",
      "title": "Close property in MLS",
      "description": "Mark listing closed/leased in MLS (attestation)",
      "deadline_rule": {
        "anchor": "lease_start_date",
        "offset_days": 0,
        "unit": "calendar",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["landlord"],
      "evidence_types": ["attestation"],
      "milestone": true
    },
    "send_lease_applications": {
      "phase": "tenant_packet",
      "title": "Send lease applications and necessary documents",
      "description": "Send application packet to applicants via portal/email",
      "deadline_rule": {
        "anchor": "application_opened_date",
        "offset_days": 0,
        "unit": "calendar",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["tenant"],
      "evidence_types": ["portal", "email", "attestation"],
      "telegram_forbidden": true,
      "sensitivity_class": "confidential"
    },
    "collect_pay_stubs": {
      "phase": "tenant_packet",
      "title": "Collect pay stubs",
      "description": "Secure upload of applicant pay stubs (portal only)",
      "deadline_rule": {
        "anchor": "application_opened_date",
        "offset_days": 3,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "buyer",
      "required": true,
      "sides": ["tenant"],
      "evidence_types": ["secure_upload"],
      "telegram_forbidden": true,
      "sensitivity_class": "restricted_tenant"
    },
    "collect_ids": {
      "phase": "tenant_packet",
      "title": "Collect IDs",
      "description": "Secure upload of government IDs (portal only)",
      "deadline_rule": {
        "anchor": "application_opened_date",
        "offset_days": 3,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "buyer",
      "required": true,
      "sides": ["tenant"],
      "evidence_types": ["secure_upload"],
      "telegram_forbidden": true,
      "sensitivity_class": "restricted_tenant"
    },
    "collect_completed_applications": {
      "phase": "tenant_packet",
      "title": "Collect completed applications",
      "description": "Collect signed/completed lease applications via secure portal",
      "deadline_rule": {
        "anchor": "application_opened_date",
        "offset_days": 5,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["tenant"],
      "evidence_types": ["secure_upload", "document"],
      "telegram_forbidden": true,
      "sensitivity_class": "restricted_tenant"
    },
    "send_package_to_listing_agent": {
      "phase": "tenant_packet",
      "title": "Send package to listing agent",
      "description": "Transfer complete applicant package with audit trail (not Telegram)",
      "deadline_rule": {
        "anchor": "application_opened_date",
        "offset_days": 7,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["tenant"],
      "evidence_types": ["portal", "email", "attestation"],
      "telegram_forbidden": true,
      "sensitivity_class": "confidential"
    },
    "compliance_upload_tenant": {
      "phase": "tenant_packet",
      "title": "Upload documentation into compliance",
      "description": "Upload tenant packet to brokerage compliance (attestation)",
      "deadline_rule": {
        "anchor": "application_opened_date",
        "offset_days": 10,
        "unit": "business",
        "time_of_day": "end_of_business"
      },
      "responsibility": "agent",
      "required": true,
      "sides": ["tenant"],
      "evidence_types": ["attestation"],
      "telegram_forbidden": true,
      "sensitivity_class": "confidential",
      "milestone": true
    }
  },
  "business_day_rules": {
    "excluded_days": ["saturday", "sunday"],
    "holidays": [
      "2026-01-01",
      "2026-07-04",
      "2026-11-26",
      "2026-12-25"
    ]
  }
}
